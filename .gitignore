# Visual Studio cache files
.vs/
ipch/
*.suo
*.user
*.VC.db
*.VC.VC.opendb

# Ignore everything inside build folder initially
/build/*

# Except keep the DLL and LIB files in Release and Debug folders
!/build/Release/
/build/Release/*
!/build/Release/*.dll
!/build/Release/*.lib

!/build/Debug/
/build/Debug/*
!/build/Debug/*.dll
!/build/Debug/*.lib

# Other Visual Studio build files
Debug/
Release/
x64/
x86/
bin/
obj/

# Logs and temporary files
*.log

# Precompiled Headers
*.pch
*.pdb
*.idb

# Visual Studio generated files
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf

# Executable files
*.exe
*.out
*.app

# Libraries and other build outputs
*.dll
*.lib
*.exp
*.ilk
*.iobj
*.ipdb

# Backup & autosave files
*.bak
*.orig

# Miscellaneous files
*.cache
*.tmp
*.stackdump

# Other environment files
CMakeSettings.json
CMakePresets.json
out/
